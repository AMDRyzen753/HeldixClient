root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,mjs,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{java,gradle}]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
