{
  "name": "heldixclient-launcher",
  "productName": "HeldixClient",
  "version": "0.12.1",
  "description": "Minecraft-Launcher mit eigenem Mod-Loader (Heldix Loader), Client-Mod und Addon-System",
  "license": "MIT",
  "author": "HeldixClient contributors",
  "homepage": "https://github.com/AMDRyzen753/HeldixClient#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AMDRyzen753/HeldixClient.git"
  },
  "bugs": {
    "url": "https://github.com/AMDRyzen753/HeldixClient/issues"
  },
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "mod": "node scripts/build-mod.mjs",
    "icon": "electron scripts/render-icon.mjs",
    "ui-assets": "electron scripts/render-ui-assets.mjs",
    "dist": "npm run mod && npm run build && electron-builder --win",
    "test:launch": "npm run build && node dist/scripts/test-launch.js",
    "test:discord": "npm run build && node dist/scripts/test-discord.js",
    "dev-key": "npm run build && node dist/scripts/dev-key.js",
    "capes": "electron scripts/render-capes.mjs",
    "update-key": "npm run build && node dist/scripts/release.js --init",
    "release": "npm run dist && node dist/scripts/release.js",
    "test:update": "npm run build && node dist/scripts/test-update.js",
    "dist:mac": "npm run mod && npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "dev.heldixclient.launcher",
    "productName": "HeldixClient",
    "copyright": "© 2026 HeldixClient",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*.js",
      "dist/renderer/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/client-mods",
        "to": "client-mods",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/heldix-addons",
        "to": "heldix-addons",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/heldix-loader",
        "to": "heldix-loader",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/heldix-loader-fabric",
        "to": "heldix-loader-fabric",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/launcher-bridge",
        "to": "launcher-bridge",
        "filter": [
          "*.jar",
          "*.png"
        ]
      }
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HeldixClient",
      "artifactName": "HeldixClient-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0",
      "artifactName": "HeldixClient-mac-${arch}.${ext}",
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 HeldixClient"
      }
    },
    "dmg": {
      "title": "HeldixClient ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
