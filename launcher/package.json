{
  "name": "heldixclient-launcher",
  "productName": "HeldixClient",
  "version": "0.14.1",
  "description": "Minecraft-Launcher mit eigenem Mod-Loader (Heldix Loader), Client-Mod und Addon-System",
  "license": "MIT",
  "author": "HeldixClient contributors",
  "homepage": "https://github.com/AMDRyzen753/HeldixClient#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AMDRyzen753/HeldixClient.git"
  },
  "bugs": {
    "url": "https://github.com/AMDRyzen753/HeldixClient/issues"
  },
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "mod": "node scripts/build-mod.mjs",
    "icon": "electron scripts/render-icon.mjs",
    "ui-assets": "electron scripts/render-ui-assets.mjs",
    "installer-art": "electron scripts/render-installer.mjs",
    "dmg-art": "electron scripts/render-dmg.mjs",
    "dist": "npm run mod && npm run build && electron-builder --win",
    "test:launch": "npm run build && node dist/scripts/test-launch.js",
    "test:discord": "npm run build && node dist/scripts/test-discord.js",
    "test:presence": "npm run build && node dist/scripts/test-presence.js",
    "test:worlds": "npm run build && node dist/scripts/test-worlds.js",
    "test:notifications": "npm run build && node dist/scripts/test-notifications.js",
    "capes": "electron scripts/render-capes.mjs",
    "update-key": "npm run build && node dist/scripts/release.js --init",
    "release": "npm run dist && node dist/scripts/release.js",
    "release:mac": "npm run build && node dist/scripts/release-mac.js",
    "addon": "npm run build && node dist/scripts/addon-release.js",
    "cosmetic": "npm run build && node dist/scripts/cosmetic-release.js",
    "cosmetic:preview": "npm run build && node dist/scripts/cosmetic-preview.js",
    "cosmetics-art": "node scripts/render-cosmetics.mjs",
    "discord-art": "node scripts/render-discord-art.mjs",
    "cosmetics-import": "node scripts/import-java-cosmetics.mjs",
    "blender-import": "npm run build && node scripts/import-blender-cosmetics.mjs",
    "test:cosmetics": "npm run build && node dist/scripts/test-cosmetics.js",
    "test:cosmetics-client": "npm run build && node dist/scripts/test-cosmetics-client.js",
    "test:update": "npm run build && node dist/scripts/test-update.js",
    "test:background": "npm run build && node dist/scripts/test-background.js",
    "test:crash": "npm run build && node dist/scripts/test-crash.js",
    "test:serverstatus": "npm run build && node dist/scripts/test-serverstatus.js",
    "test:social": "npm run build && node dist/scripts/test-social.js",
    "test:freunde": "npm run build && node dist/scripts/test-friends2.js",
    "test:invites": "npm run build && node dist/scripts/test-invites.js",
    "test:profile": "npm run build && node dist/scripts/test-profile.js",
    "test:store": "npm run build && node dist/scripts/test-store.js",
    "test:content": "npm run build && node dist/scripts/test-content.js",
    "test:accounts-ipc": "npm run build && node dist/scripts/test-accounts-ipc.js",
    "test:setup": "npm run build && node dist/scripts/test-setup.js",
    "test:setup-teilen": "npm run build && node dist/scripts/test-setupshare.js",
    "dist:mac": "npm run mod && npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "dev.heldixclient.launcher",
    "productName": "HeldixClient",
    "copyright": "© 2026 HeldixClient",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*.js",
      "dist/renderer/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/client-mods",
        "to": "client-mods",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/heldix-loader",
        "to": "heldix-loader",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/heldix-loader-fabric",
        "to": "heldix-loader-fabric",
        "filter": [
          "*.jar"
        ]
      }
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "HeldixClient-Einladung",
        "schemes": [
          "heldixclient"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HeldixClient",
      "artifactName": "HeldixClient-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0",
      "artifactName": "HeldixClient-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 HeldixClient"
      }
    },
    "dmg": {
      "title": "HeldixClient ${version}",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 196,
          "type": "file"
        },
        {
          "x": 390,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
